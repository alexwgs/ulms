  <select id="selectDailyConfigCalendar" parameterType="java.lang.String" resultMap="BaseResultMap">
  select a.ID, a.QUES_CODE, a.QUES_DATE,b.valid as GROUP_ID, a.OPTION_RAND, a.ARTICAL_ID from
  (SELECT * FROM TRM_DAILY_CONFIG where ques_date BETWEEN concat(#{dataMonth,jdbcType=VARCHAR},'-01') and concat(#{dataMonth,jdbcType=VARCHAR},'-31') and group_id is null) a left join
