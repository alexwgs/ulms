   </resultMap>
  <select id="getUserStatusAndOhtFlag"  parameterType="java.lang.Integer" resultMap="userStatusMap">
    select c.status_name as level1,b.status_name as level2,a.status_name as level3,a.oht_flag||'' as oht_flag from 
	(select status_name,pid,oht_flag from OTH_STATUS_TYPE where ID = #{id,jdbcType=DECIMAL} ) a left join 
	(select status_name,id,pid from OTH_STATUS_TYPE where level_grade=2 and data_type='status') b on (a.pid = b.id)
	left join (select status_name,id,pid from OTH_STATUS_TYPE where level_grade=1 and data_type='status') c 
	on (b.pid = c.id)
  </select>

  <select id="getAllStatusType" resultMap="BaseResultMap">
	select a.id,c.status_name||'-'||a.status_name as status_name from
	(select id,pid,status_name,sort from OTH_STATUS_TYPE where data_type = 'status' and level_grade=3) a left join 
	(select id,pid,status_name,sort from OTH_STATUS_TYPE where data_type = 'status' and level_grade=2) b on (a.pid = b.id) left join
	(select id,pid,status_name,sort from OTH_STATUS_TYPE where data_type = 'status' and level_grade=1) c on (b.pid = c.id) order by c.id,b.sort,a.sort
