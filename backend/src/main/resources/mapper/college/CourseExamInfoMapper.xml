  <insert id="insertNewExam">
    INSERT INTO TRM_COURSE_EXAM_INFO ( JOURNO, EXAM_CODE, QUES_CODE, PLO_NUM, QUES_ORDER )
    SELECT to_char(sysdate,'yymmdd')||trim(to_char(TRM_GEN_BN.NEXTVAL,'0000000')),#{examCode,jdbcType=VARCHAR} ,QUES_CODE, #{ploNum,jdbcType = VARCHAR },rownum QUES_ORDER
    FROM
      ( SELECT QUES_CODE FROM TRM_QUES_BANK WHERE LIB_CODE = #{libCode, jdbcType = VARCHAR } AND QUES_STAT = 1
        ORDER BY round( QUES_CODE / to_char( SYSDATE, 'miss' ), 4 ) - floor( QUES_CODE / to_char( SYSDATE, 'miss' )) )
    WHERE
      ROWNUM &lt;= #{ quesNum,jdbcType = DECIMAL }
