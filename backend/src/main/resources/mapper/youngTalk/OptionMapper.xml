<resultMap id="optionsChoose" type="java.util.HashMap">
    <result column="answer" property="选项" jdbcType="VARCHAR" />
    <result column="nums" property="选择人数" jdbcType="DECIMAL" />
</resultMap>


  <select id="selectRadioNumGroupByQuestionId" resultMap="optionsChoose">
  	select a.CONTENT as answer,nvl(b.nums,0) as nums FROM (select CONTENT,SORT FROM CYT_SURVEY_OPTION where ARTICAL_ID = #{articalId,jdbcType=DECIMAL} and QUESTION_ID=#{questionId,jdbcType=DECIMAL} ORDER BY SORT)a
  	left join 
  	( select ANSWER,COUNT(0) as nums FROM CYT_SURVEY_ANSWER WHERE ARTICAL_ID = #{articalId,jdbcType=DECIMAL} and QUESTION_ID=#{questionId,jdbcType=DECIMAL} GROUP BY ANSWER ) b
  	on (a.CONTENT = b.ANSWER)
  </select>
  
  <select id="selectCheckboxNumGroupByOptionId" resultType="java.lang.Integer">
  	  select count(*) from CYT_SURVEY_ANSWER WHERE ( ARTICAL_ID =  #{articalId,jdbcType=DECIMAL}  AND QUESTION_ID = #{questionId,jdbcType=DECIMAL}) and (answer like CONCAT('%|',#{option,jdbcType=DECIMAL}) or answer like CONCAT(#{option,jdbcType=DECIMAL},'|%') or answer like CONCAT(CONCAT('|',#{option,jdbcType=DECIMAL}),'|') or answer = #{option,jdbcType=DECIMAL} ) 
  </select>
